{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustguard.local/contracts/v1/experience_upsert.schema.json",
  "title": "TrustGuard Experience Upsert v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "external_id",
    "source_system",
    "source_revision",
    "knowledge_scope",
    "workflow_type",
    "experience_type",
    "visibility",
    "conditions",
    "action_summary",
    "outcome_summary"
  ],
  "properties": {
    "schema_version": {
      "const": "trustguard-experience-upsert-v1"
    },
    "external_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "knowledge_scope": {
      "enum": ["penetration", "alert-triage"]
    },
    "workflow_type": {
      "enum": ["penetration", "alert-triage"]
    },
    "experience_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "workspace_id": {
      "type": ["string", "null"],
      "minLength": 1,
      "maxLength": 128
    },
    "visibility": {
      "enum": ["global", "workspace"]
    },
    "conditions": {
      "type": "object",
      "maxProperties": 50
    },
    "action_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "outcome_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "skill_id": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "phase": {
      "type": ["string", "null"],
      "maxLength": 64
    },
    "source_task_id": {
      "type": ["string", "null"],
      "maxLength": 128
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "ref"],
        "properties": {
          "type": {
            "enum": ["task_chunk", "artifact", "trace"]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "visibility": {
            "const": "workspace"
          }
        },
        "required": ["visibility"]
      },
      "then": {
        "required": ["workspace_id"],
        "properties": {
          "workspace_id": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "visibility": {
            "const": "global"
          }
        },
        "required": ["visibility"]
      },
      "then": {
        "properties": {
          "workspace_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow_type": {
            "const": "penetration"
          }
        },
        "required": ["workflow_type"]
      },
      "then": {
        "properties": {
          "knowledge_scope": {
            "const": "penetration"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "workflow_type": {
            "const": "alert-triage"
          }
        },
        "required": ["workflow_type"]
      },
      "then": {
        "properties": {
          "knowledge_scope": {
            "const": "alert-triage"
          }
        }
      }
    }
  ]
}
