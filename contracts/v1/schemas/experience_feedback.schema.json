{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustguard.local/contracts/v1/experience_feedback.schema.json",
  "title": "TrustGuard Experience Feedback v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "experience_id",
    "task_id",
    "workflow_type",
    "outcome",
    "evidence_level"
  ],
  "properties": {
    "schema_version": {
      "const": "trustguard-experience-feedback-v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "experience_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "workflow_type": {
      "enum": ["penetration", "alert-triage"]
    },
    "outcome": {
      "enum": ["success", "failure", "neutral"]
    },
    "evidence_level": {
      "enum": ["reported", "observed", "verified"]
    },
    "notes": {
      "type": ["string", "null"],
      "maxLength": 2000
    },
    "occurred_at": {
      "type": ["string", "null"],
      "format": "date-time"
    }
  }
}
