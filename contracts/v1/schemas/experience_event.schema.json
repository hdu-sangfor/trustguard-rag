{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trustguard.local/contracts/v1/experience_event.schema.json",
  "title": "TrustGuard Experience Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "event_type",
    "aggregate_id",
    "occurred_at",
    "producer",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "const": "trustguard-experience-event-v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_type": {
      "enum": ["experience.candidate.upserted", "experience.feedback.recorded"]
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "traceparent": {
      "type": ["string", "null"],
      "maxLength": 256
    },
    "payload": {
      "type": "object"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "experience.candidate.upserted"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "experience_upsert.schema.json"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "experience.feedback.recorded"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "experience_feedback.schema.json"
          }
        }
      }
    }
  ]
}
